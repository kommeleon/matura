]

var arrays_to_render = [[plane_001, plane, ziel_1, ziel_2, ziel_3, ziel_4, ziel_5, plane_002, plane_003, plane_004, plane_005, plane_011], [cube_005, cube_006, cube_007, cube_008, cube_009, cube_010, cube_011], [plane_006, plane_007, plane_008, plane_009, plane_010, suzanne, torus, icosphere]]

var camera_pos = Vector3(0,0,0)
var camera_rot = Vector2(0,0)
var scene = 0



func _raycast(ray_origin: Vector3, ray_direction: Vector3, vectors: Array):
	
	# Volle Erklärung: https://en.wikipedia.org/wiki/M%C3%B6ller%E2%80%93Trumbore_intersection_algorithm#Implementations
	# Ich nutzte die Beispiele die auf anderen Programmiersprachen geschrieben worden sind und übersetzte sie auf GDScript
	
	const EPSILON = 0.0000001

	var edge_1 = vectors[1] - vectors[0]
	var edge_2 = vectors[2] - vectors[0]
	
	var ray_cross_edge_2 = ray_direction.cross(edge_2)
	var determinant = edge_1.dot(ray_cross_edge_2)
	
	if -EPSILON < determinant and determinant < EPSILON:
		return null
	
	var inverted_determinant = 1.0 / determinant
	var origin_to_vector_0 = ray_origin - vectors[0]
	
	var u_barycentric = inverted_determinant * origin_to_vector_0.dot(ray_cross_edge_2)
	
	if u_barycentric < 0.0 or u_barycentric > 1.0:
		return null
	
	var origin_cross_edge_1 = origin_to_vector_0.cross(edge_1)
	
	var v_barycentric = inverted_determinant * ray_direction.dot(origin_cross_edge_1)
	if v_barycentric < 0.0 or (u_barycentric + v_barycentric) > 1.0:
		return null
		
	var hit_distance = inverted_determinant * edge_2.dot(origin_cross_edge_1)
	
	if hit_distance > EPSILON:
		return hit_distance
	
	return null
	

func _calculate_screen_rays(camera_rot, rows, columns):
	
	# Diese Funktion nimmt die Ecken des Bildschirms und berechnet alle Vektoren die es zwischen den Ecken
	# braucht, damit man die gewünschte Bildschirm Auflösung erreicht
	# (Die Funktion ist gleich wie die vom Voxel-Ray-Traversal-Algorithmus)
	
	var ray_direction = Basis.from_euler(Vector3(camera_rot.x, camera_rot.y, 0)) #
	
	var top_left = (ray_direction * Vector3(-0.75, 0.445, 0.5)).normalized()
	var top_right = (ray_direction * Vector3(0.75, 0.445, 0.5)).normalized()
	var bottom_left = (ray_direction * Vector3(-0.73, -0.38, 0.5)).normalized()
	var bottom_right = (ray_direction * Vector3(0.73, -0.38, 0.5)).normalized()

	var screen_rays = []
	var left_ray = top_left
	var right_ray = top_right
	
	for row in range(rows):
		var column_rays = []
		var weight_rows = float(row) / rows
		left_ray = top_left.lerp(bottom_left, weight_rows)
		right_ray = top_right.lerp(bottom_right, weight_rows)
		
		for column in range(columns): # Es nimmt die Vektoren links und rechts und berechnet alle Vektoren dazwischen.
			var weight_columns = float(column) / columns
			var mixed_ray = left_ray.lerp(right_ray, weight_columns)
			
			column_rays.append(mixed_ray.normalized())
		
		screen_rays.append(column_rays)
	return(screen_rays)


func _draw():
	var viewport_size = get_viewport_rect().size
	var rows = 20
	var columns = int(rows * 16/9)
	
	var cell_width = viewport_size.x / columns
	var cell_height = viewport_size.y / rows
	
	
	var screen_rays = _calculate_screen_rays(camera_rot, rows, columns)
	# Man berechnet _raycast für alle:
	
	for row in range(screen_rays.size()):						# Zeilen im Bildschirm
		for column in range(screen_rays[row].size()):			# Spalten in den Zeilen
			var closest_hit_distance = INF
			for array in arrays_to_render[scene]:				# Objekte in der Szene
				for triangle in array:							# Polygone in den Objekten
					var hit_distance = _raycast(camera_pos, screen_rays[row][column], triangle)
					
					if hit_distance != null:
						if hit_distance < closest_hit_distance:
							closest_hit_distance = hit_distance
							
			var color = Color(0.0, 0.0, 0.0, 1.0)
			if closest_hit_distance != INF:
				var brightness = clamp(1.0 - (closest_hit_distance / 200.0), 0.0, 1.0) # Wenn ein Objekt näher ist erschient der Pixel heller
